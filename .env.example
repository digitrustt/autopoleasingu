# Lokalny Postgres z Homebrew (postgresql@16). Baza: createdb auta
DATABASE_URL=postgres://kuba@localhost:5432/auta

# Wariant z docker-compose (gdy wolisz kontener zamiast Homebrew):
# DATABASE_URL=postgres://auta:auta@localhost:5433/auta

# Produkcja za darmo: Neon free tier — https://neon.tech
# DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/auta?sslmode=require

# Telegram (darmowe alerty). Bota zaklada sie u @BotFather, chat_id z @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kontakt w User-Agencie scrapera — realnie zmniejsza szanse bana
SCRAPER_CONTACT=kozakooo13@gmail.com
